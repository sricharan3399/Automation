# ---------------------------------------------------------------------------
# Deterministic line endings across machines.
#
# This matters for deployment: a .bat file checked out with LF endings can be
# mis-parsed by cmd.exe, and a PowerShell script with mixed endings produces
# confusing errors. Pinning them removes a whole class of "works on my laptop".
# ---------------------------------------------------------------------------

# Let git decide for anything not listed below.
* text=auto

# --- Windows-native: must be CRLF ------------------------------------------
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf

# --- Cross-platform source: keep LF ----------------------------------------
*.py   text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.md   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf
.env.example   text eol=lf
VERSION        text eol=lf

# --- Binary: never touched --------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary

# --- Diff noise -------------------------------------------------------------
# The lockfile and the synthetic fixtures are generated; collapsing them keeps
# review focused on hand-written changes.
dashboard/package-lock.json  linguist-generated=true -diff
tests/golden_dataset/events/*.json  linguist-generated=true -diff
