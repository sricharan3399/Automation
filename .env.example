# ---------------------------------------------------------------------------
# AV Test Automation Platform - environment template
#
# This file contains FIELD NAMES ONLY. It is committed to git on purpose.
# Never put a real password, token, API key or client secret in here.
#
# SETUP_AND_START.bat copies this to `.env` on first run and never overwrites an
# existing `.env`. `.env` is gitignored.
#
# For production, prefer the OS credential store or the approved corporate
# secret manager over `.env`. See docs/SECURITY.md.
# ---------------------------------------------------------------------------

# --- Application -----------------------------------------------------------
AV_ENV=local
AV_HOST=127.0.0.1
AV_PORT=8000
AV_LOG_LEVEL=INFO

# Operating mode: production | demo
#   production : synthetic datasets are REFUSED; an unavailable source fails
#                the run rather than silently substituting fake data
#   demo       : synthetic dataset is selectable and always labelled DEMO
AV_MODE=production

# --- Database --------------------------------------------------------------
# SQLite (default, zero administration). Each laptop creates its own.
AV_DATABASE_URL=sqlite:///./data/local.db
# PostgreSQL + PostGIS (enterprise). Supply the password through the credential
# store, not here.
# AV_DATABASE_URL=postgresql+psycopg://av_user:@localhost:5432/av_automation

# --- Operator identity (local desktop session) -----------------------------
AV_LOCAL_USER=local.tester
# viewer | tester | senior_tester | administrator
AV_LOCAL_ROLE=tester

# --- NVIDIA / Internal Data Scout ------------------------------------------
# LEAVE BLANK until the approved connection details have been supplied.
# The adapter refuses to operate while unconfigured; it never fabricates a
# connection or results. The dashboard starts normally either way.
AV_DATASCOUT_ENABLED=false
AV_DATASCOUT_BASE_URL=
# rest_api | sdk | graphql | cli | database | csv_export | json_export | browser
AV_DATASCOUT_INTEGRATION_TYPE=rest_api
# none | bearer | api_key | oauth_client_credentials
AV_DATASCOUT_AUTH_MODE=none
AV_DATASCOUT_VERIFY_TLS=true
AV_DATASCOUT_TIMEOUT_SECONDS=60
#
# DO NOT put the token here. Store it in the Windows Credential Manager:
#   .venv\Scripts\python.exe -c "import keyring; keyring.set_password('av-test-automation','AV_DATASCOUT_TOKEN','<token>')"
# or have the approved secret injector export it into the environment.
AV_DATASCOUT_TOKEN=
AV_DATASCOUT_API_KEY=

# --- Local file adapter (development / approved exported datasets) ---------
AV_LOCAL_DATASET_DIR=./tests/golden_dataset

# --- Optional services -----------------------------------------------------
AV_MAP_SERVICE_URL=
AV_OBJECT_STORE_URL=
AV_EVIDENCE_DIR=./output

# --- Pseudonymisation ------------------------------------------------------
# Leave blank to have a per-installation salt generated on first run and stored
# outside the repository. Set it only to correlate references across machines.
AV_REDACTION_SALT=

# --- Safety switches (do not enable without written approval) --------------
AV_ALLOW_PRODUCTION_SUBMISSION=false
AV_ALLOW_BROWSER_AUTOMATION=false
AV_SOURCE_ACCESS_MODE=read_only
